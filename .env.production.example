# Copy to .env.production, replace every CHANGE_ME value, keep the file private.
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_PRIVATE_VALUE_OF_AT_LEAST_50_CHARACTERS
POSTGRES_DB=modus
POSTGRES_USER=modus_owner
POSTGRES_PASSWORD=CHANGE_ME_OWNER_PASSWORD
APP_DB_USER=modus_runtime
APP_DB_PASSWORD=CHANGE_ME_RUNTIME_PASSWORD
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://localhost:8443
BUSINESS_TIMEZONE=Asia/Bishkek
DB_JIT=0
OPERATIONS_TOKEN=CHANGE_ME_PRIVATE_MONITORING_TOKEN
TLS_CERT_DIR=./.local/tls
HTTPS_PORT=8443
BACKUP_DIR=./.local/production-backups
# External notifications; leave empty to keep a channel off.
SITE_URL=https://localhost:8443
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
BITRIX24_WEBHOOK_URL=
