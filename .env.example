# Local demo. Use PostgreSQL and private credentials for a pilot.
DEBUG=1
DEMO_MODE=1
SECRET_KEY=local-demo-only-not-a-production-secret
ALLOWED_HOSTS=localhost,127.0.0.1
BUSINESS_TIMEZONE=Asia/Bishkek
DB_ENGINE=sqlite
POSTGRES_DB=modus
POSTGRES_USER=modus
POSTGRES_PASSWORD=change-local-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
APP_DB_USER=modus_runtime
APP_DB_PASSWORD=change-local-runtime-password
DEMO_PASSWORD=ModusDemo2026!
TRUST_PROXY=0
DB_JIT=0
# Optional private bearer token for /operations/metrics/
OPERATIONS_TOKEN=

# --- External notifications (e-mail, Telegram, Bitrix24) ---
# Base URL used in links inside messages.
SITE_URL=http://127.0.0.1:8000
# E-mail. Without EMAIL_HOST the local demo saves letters to .local/sent-emails/.
NOTIFY_EMAIL=1
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=
# Telegram: create a bot with @BotFather and paste its token. The worker polls the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Bitrix24: inbound webhook with scopes "user" and "im", e.g. https://portal.bitrix24.ru/rest/1/abc123
BITRIX24_WEBHOOK_URL=
